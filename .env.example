# Copy to .env and use a MySQL user with SELECT-only privileges.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=weather_web_ro
MYSQL_PASSWORD=REPLACE_ME
MYSQL_DATABASE=weather_station_v2
STATION_TIMEZONE=America/Chicago
# If MySQL is on the Docker host, use a reachable LAN IP for MYSQL_HOST
# or configure host-gateway in compose.yaml.
